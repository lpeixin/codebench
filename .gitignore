# ---------------------------------------------------------------------------
# Dependencies & build output
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/

# Rust / Tauri build artifacts. `target*` (no slash) also catches the temporary
# `targetXXXXXX` directories cargo creates while probing.
src-tauri/target*/
src-tauri/gen/schemas/
# Local cargo home, only used when the global ~/.cargo is not writable
.cargo-home/

# ---------------------------------------------------------------------------
# Local data & generated files
# ---------------------------------------------------------------------------
# SQLite: the app stores its DB in the OS app-data dir, but a dev build or a
# manual test can drop one here. Sidecar files matter: -wal can hold rows that
# were never checkpointed into the main file.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# Icons are generated by `npm run icon`; only the desktop set is committed.
icon-src.png
src-tauri/icons/android/
src-tauri/icons/ios/

# ---------------------------------------------------------------------------
# Secrets & local configuration
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# ---------------------------------------------------------------------------
# Assistant workspace (local memory: machine paths, notes — not project source)
# ---------------------------------------------------------------------------
.workbuddy-ai/
.claude/
.cursor/

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# Editors & OS junk
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Scratch files left by failed tool runs in this checkout (safe to delete)
# ---------------------------------------------------------------------------
.sandbox-probe
.unlink-probe
uyq0ryl2
